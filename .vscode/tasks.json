{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build sfml test", // Etiqueta para esta tarea de compilación
            "type": "shell",
            "command": "g++", // Comando del compilador
            "args": [
                "-g", // Habilita la información de depuración

                // Archivo fuente a compilar (¡SOLO sfml_test.cpp para esta prueba!)
                "${workspaceFolder}\\src\\sfml_test.cpp",

                // Ruta y nombre del ejecutable de salida
                "-o",
                "${workspaceFolder}\\output\\sfml_test.exe",

                // Rutas a los directorios de inclusión (headers) de SFML
                // Asegúrate que 'C:/SFML' sea la ruta correcta donde descomprimiste SFML
                "-I", "C:/SFML/include",

                // Rutas a los directorios de librerías de SFML
                "-L", "C:/SFML/lib",

                // Librerías de SFML a enlazar (versión de depuración - con '-d')
                "-lsfml-graphics-d",
                "-lsfml-window-d",
                "-lsfml-system-d",
                // Descomenta si usas los módulos de audio o red de SFML
                // "-lsfml-audio-d",
                // "-lsfml-network-d",

                // Librerías del sistema Windows que SFML necesita
                "-lopengl32",
                "-lwinmm",
                "-lgdi32"
            ],
            "options": {
                "cwd": "${workspaceFolder}" // Directorio de trabajo actual
            },
            "problemMatcher": [
                "$gcc" // Para que VS Code interprete los errores de g++
            ],
            "group": {
                "kind": "build",
                "isDefault": true // Hace que esta sea la tarea de compilación predeterminada
            },
            "detail": "Compila el archivo de prueba SFML"
        }
    ]
}