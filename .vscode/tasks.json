{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build sfml",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/g++.exe", // <--- RUTA CORRECTA AQUI
            "args": [
                "-g",
                "-std=c++17",
                "${workspaceFolder}/src/*.cpp",
                "-I", "C:/msys64/mingw64/include", // <--- RUTA CORRECTA AQUI
                "-L", "C:/msys64/mingw64/lib",    // <--- RUTA CORRECTA AQUI
                "-o", "${workspaceFolder}/output/UpperOrLowerHand.exe",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-lsfml-audio",
                "-lsfml-network",
                "-lopengl32",
                "-lws2_32",
                "-lwinmm",
                "-lgdi32"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Tarea de compilación para SFML con g++"
        },
        {
            "label": "run sfml",
            "type": "shell",
            "command": "${workspaceFolder}/output/UpperOrLowerHand.exe",
            "group": "test",
            "problemMatcher": []
        }
    ]
}